{
  "name": "@mailhooks/mcp",
  "version": "2.0.1",
  "description": "MCP server for Mailhooks API — full coverage for inboxes, emails, webhooks, domains, tenant & usage",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mailhooks/integrations.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://mailhooks.dev",
  "bugs": {
    "url": "https://github.com/Mailhooks/integrations/issues"
  },
